---
import BaseLayout from "./BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { SITE_URL, AUTHOR } from "../consts";
import { formatDate } from "../utils/date";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
}

const { title, description, pubDate, updatedDate, tags } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL);
---

<BaseLayout title={`${title} - ${AUTHOR}`} description={description}>
  <main class="doc flow">
    <article class="flow">
      <PageHeader title={title} article>
        <p class="mt-[0.5em] text-meta text-foreground-dim">
          {formatDate(pubDate)}
          {updatedDate && <> · updated {formatDate(updatedDate)}</>}
          {tags.length > 0 && <> · {tags.join(", ")}</>}
        </p>
        {
          description && (
            <p class="mt-[0.9em] text-foreground-soft">{description}</p>
          )
        }
      </PageHeader>

      <div class="prose">
        <slot />
      </div>
    </article>

    <footer>
      <a class="text-foreground-dim no-underline hover:text-accent" href="/blog"
        >Writing</a
      >
    </footer>
  </main>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      url: canonical.href,
      datePublished: pubDate.toISOString(),
      ...(updatedDate && { dateModified: updatedDate.toISOString() }),
      author: {
        "@type": "Person",
        name: AUTHOR,
        url: SITE_URL,
      },
      keywords: tags,
    })}
  />

  <script is:inline define:vars={{ postTitle: title, postTags: tags }}>
    window.posthog?.capture("blog_post_viewed", {
      title: postTitle,
      tags: postTags,
    });
  </script>
</BaseLayout>
