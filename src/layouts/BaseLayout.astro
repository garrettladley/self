---
import "../styles/global.css";
import bodyFontUrl from "../assets/fonts/lilex-latin-400-normal.woff2?url";
import { ClientRouter } from "astro:transitions";
import { PUBLIC_POSTHOG_PROJECT_TOKEN } from "astro:env/client";
import Analytics from "../components/Analytics.astro";
import PostHog from "../components/PostHog.astro";
import { AUTHOR, SITE_DESCRIPTION, SOCIAL_PROFILES } from "../consts";
import { getSiteUrl, isVercelPreview } from "../utils/site-url";
import { canonicalUrl } from "../utils/url";
import { personId, personSchema } from "../utils/structured-data";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  pageType?: "WebPage" | "ProfilePage" | "CollectionPage";
  mainEntity?: Record<string, unknown>;
}

const {
  title = AUTHOR,
  description = SITE_DESCRIPTION,
  ogImage = "/og.png",
  noIndex = false,
  pageType = "WebPage",
  mainEntity,
} = Astro.props;

const site = getSiteUrl({ url: Astro.url, site: Astro.site });
const canonical = canonicalUrl(Astro.url.pathname, site);
const personReference = { "@id": personId(site) };
const pageEntity =
  mainEntity ?? (pageType === "ProfilePage" ? personReference : undefined);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    personSchema(site),
    {
      "@type": pageType,
      "@id": `${canonical.href}#webpage`,
      url: canonical.href,
      name: title,
      description,
      author: personReference,
      ...(pageEntity && { mainEntity: pageEntity }),
    },
  ],
};
const ogImageUrl = new URL(ogImage, site).href;
const rssUrl = new URL("/rss.xml", site);
const shouldNoIndex = noIndex || isVercelPreview();
const shouldLoadPostHog =
  import.meta.env.PROD && Boolean(PUBLIC_POSTHOG_PROJECT_TOKEN);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <meta name="generator" content={Astro.generator} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={AUTHOR} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SOCIAL_PROFILES.x.handle} />
    <meta name="twitter:creator" content={SOCIAL_PROFILES.x.handle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={AUTHOR}
      href={rssUrl.href}
    />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href={bodyFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#f5f4ef" />
    {shouldNoIndex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <ClientRouter fallback="swap" />
    {shouldLoadPostHog && <PostHog />}
    {shouldLoadPostHog && <Analytics />}

    {
      !noIndex && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
