---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const formatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const formatDate = (date: Date) => formatter.format(date);
---

<BaseLayout
  title="Writing - Garrett Ladley"
  description="Writing by Garrett Ladley."
>
  <main
    class="mx-auto w-full max-w-page px-page-x pt-[calc(60px+var(--page-padding-block))] pb-[calc(60px+var(--page-padding-block))] flex-1 flex flex-col"
  >
    <h1 class="sr-only">Writing</h1>
    <div
      class="mb-6 flex items-center justify-between font-mono text-meta uppercase tracking-[0.04em] text-foreground-muted"
    >
      <span class="text-foreground-dim"
        >{posts.length} {posts.length === 1 ? "post" : "posts"}</span
      >
      <a
        href="/rss.xml"
        class="text-foreground-dim no-underline transition-colors duration-150 hover:text-accent"
      >
        rss
      </a>
    </div>

    <div class="flex flex-col font-mono text-body uppercase tracking-[0.04em]">
      {
        posts.length === 0 ? (
          <p class="text-foreground-muted normal-case tracking-normal">
            Posts soon.
          </p>
        ) : (
          posts.map((post, i) => (
            <a
              href={`/blog/${post.id}/`}
              class:list={[
                "grid grid-cols-[clamp(80px,16vw,120px)_1fr] gap-6 py-3 no-underline group",
                i > 0 && "border-t border-white/6",
              ]}
            >
              <div class="text-foreground-dim">
                {formatDate(post.data.pubDate)}
              </div>
              <div>
                <div class="text-foreground-muted transition-colors duration-150 group-hover:text-accent">
                  {post.data.title}
                </div>
                <div class="mt-1 truncate text-meta text-foreground-dim normal-case tracking-normal">
                  {post.data.description}
                </div>
              </div>
            </a>
          ))
        )
      }
    </div>
  </main>
</BaseLayout>
