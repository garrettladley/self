---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { formatDate } from "../../utils/date";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BaseLayout
  title="Writing - Garrett Ladley"
  description="Writing by Garrett Ladley."
>
  <main class="doc flow">
    <PageHeader title="Writing" />

    {
      posts.length === 0 ? (
        <p class="text-foreground-dim">Nothing published yet.</p>
      ) : (
        <ul class="flex flex-col gap-[1.1em]">
          {posts.map((post) => (
            <li>
              <a class="link" href={`/blog/${post.id}/`}>
                {post.data.title}
              </a>
              <p class="text-meta text-foreground-dim">
                {formatDate(post.data.pubDate)}
              </p>
            </li>
          ))}
        </ul>
      )
    }

    <p><a class="link-quiet" href="/rss.xml">RSS</a></p>
  </main>
</BaseLayout>

<script is:inline>
  function handleRssClick() {
    window.posthog?.capture("rss_feed_clicked");
  }

  function setupRssLink() {
    const rssLink = document.querySelector('a[href="/rss.xml"]');
    if (!rssLink) return;
    rssLink.removeEventListener("click", handleRssClick);
    rssLink.addEventListener("click", handleRssClick);
  }

  document.addEventListener("DOMContentLoaded", setupRssLink);
  document.addEventListener("astro:page-load", setupRssLink);
</script>
