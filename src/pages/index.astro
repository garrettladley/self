---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { SOCIAL_PROFILES } from "../consts";

const nav = [
  { label: "Writing", href: "/blog" },
  { label: "Projects", href: "/projects" },
  { label: "Library", href: "/library" },
];

const elsewhere = Object.values(SOCIAL_PROFILES);
---

<BaseLayout>
  <main class="doc flow">
    <PageHeader>
      <p class="text-foreground-soft">Member of Technical Staff at Agency AI</p>
      <p class="text-foreground-dim">New York</p>
    </PageHeader>

    <p class="max-w-[58ch] text-foreground-soft">
      I work on products and distributed systems. <br /> Massive Go fan.
    </p>

    <nav aria-label="Sections">
      <ul class="flex flex-col gap-[0.35em]">
        {
          nav.map((n) => (
            <li>
              <a class="link" href={n.href}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav
      aria-label="Elsewhere"
      class="flex flex-wrap gap-x-[1.25em] gap-y-[0.25em]"
    >
      {
        elsewhere.map((e) => (
          <a class="link-quiet" href={e.url} target="_blank" rel="noreferrer">
            {e.label}
          </a>
        ))
      }
    </nav>
  </main>
</BaseLayout>

<script is:inline>
  function handleElsewhereClick(e) {
    const link = e.currentTarget;
    window.posthog?.capture("external_link_clicked", {
      label: link.textContent?.trim(),
      href: link.getAttribute("href"),
    });
  }

  function setupElsewhereLinks() {
    const nav = document.querySelector('nav[aria-label="Elsewhere"]');
    if (!nav) return;
    nav.querySelectorAll("a").forEach(function (link) {
      link.removeEventListener("click", handleElsewhereClick);
      link.addEventListener("click", handleElsewhereClick);
    });
  }

  document.addEventListener("DOMContentLoaded", setupElsewhereLinks);
  document.addEventListener("astro:page-load", setupElsewhereLinks);
</script>
