---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { PERSON, ROLE_AND_COMPANY, SOCIAL_PROFILES } from "../consts";
import { getBlogPosts } from "../data/blog";
import { ANALYTICS_EVENTS } from "../analytics";
import { withOutboundTracking } from "../utils/outbound-url";
import { getSiteUrl } from "../utils/site-url";

const site = getSiteUrl({ url: Astro.url, site: Astro.site });
const posts = await getBlogPosts();

const nav = [
  { label: "Experience", href: "/experience" },
  ...(posts.length > 0 ? [{ label: "Writing", href: "/blog" }] : []),
  { label: "Projects", href: "/projects" },
  { label: "Library", href: "/library" },
];

const elsewhere = Object.values(SOCIAL_PROFILES);
---

<BaseLayout pageType="ProfilePage">
  <main class="doc flow">
    <PageHeader>
      <p class="text-foreground-soft">{ROLE_AND_COMPANY}</p>
      <p class="text-foreground-dim">{PERSON.location}</p>
    </PageHeader>

    <p class="max-w-[58ch] text-foreground-soft">
      {PERSON.bio}
      <br />
      {PERSON.aside}
    </p>

    <nav aria-label="Sections">
      <ul class="flex flex-col gap-[0.35em]">
        {
          nav.map((n) => (
            <li>
              <a class="link" href={n.href}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav
      aria-label="Elsewhere"
      class="flex flex-wrap gap-x-[1.25em] gap-y-[0.25em]"
    >
      {
        elsewhere.map((e) => (
          <a
            class="link-quiet"
            href={withOutboundTracking(e.url, "homepage", site)}
            target="_blank"
            rel="noreferrer"
            data-analytics-event={ANALYTICS_EVENTS.externalLinkClicked}
          >
            {e.label}
          </a>
        ))
      }
    </nav>
  </main>
</BaseLayout>
