---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { projects } from "../data/projects";
import { SITE_URL, AUTHOR } from "../consts";

const withProjectTracking = (href: string) => {
  const url = new URL(href);
  url.searchParams.set("utm_source", "garrettladley.com");
  url.searchParams.set("utm_medium", "projects");
  url.searchParams.set("utm_campaign", "self-site");
  return url.toString();
};
---

<BaseLayout
  title="Projects - Garrett Ladley"
  description="Active projects by Garrett Ladley."
>
  <main class="doc flow">
    <PageHeader title="Projects" />

    <ul class="space-y-[0.9em]">
      {
        projects.map((project) => (
          <li>
            {project.href ? (
              <a
                class="link"
                href={withProjectTracking(project.href)}
                target="_blank"
                rel="noreferrer"
              >
                {project.name}
              </a>
            ) : (
              <span>
                {project.name}
                {project.private && (
                  <span class="text-foreground-dim"> (private)</span>
                )}
              </span>
            )}
            <span class="text-foreground-soft"> — {project.description}</span>
            {project.tools.length > 0 && (
              <span class="text-foreground-dim">
                {" "}
                · {project.tools.join(", ")}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </main>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      itemListElement: projects.map((project, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "SoftwareSourceCode",
          name: project.name,
          description: project.description,
          ...(project.href && { codeRepository: project.href }),
          programmingLanguage: project.tools,
          author: {
            "@type": "Person",
            name: AUTHOR,
            url: SITE_URL,
          },
        },
      })),
    })}
  />
</BaseLayout>
