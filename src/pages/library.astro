---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { library } from "../data/library";
---

<BaseLayout
  title="Library - Garrett Ladley"
  description="Books read by Garrett Ladley, grouped by year."
>
  <main class="doc flow">
    <PageHeader title="Library" />

    {
      /* A reading ledger: the year sits in a right-aligned gutter and titles hang
        off a shared spine. Hairline rules separate the years. */
    }
    <div>
      {
        library.map((yearGroup, i) => (
          <section
            class:list={[
              "grid grid-cols-[2.75rem_1fr] gap-x-[1.5em] sm:grid-cols-[3.5rem_1fr] sm:gap-x-[2em]",
              i > 0 && "mt-[1.9em] border-t border-border pt-[1.9em]",
            ]}
          >
            <p class="text-foreground">{yearGroup.year}</p>
            <ul class="flex flex-col gap-[0.2em]">
              {yearGroup.books.map((book) => (
                <li class="text-foreground-soft">{book.title}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>
