---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { library } from "../data/library";
---

<BaseLayout
  title="Library - Garrett Ladley"
  description="Books read by Garrett Ladley, grouped by year."
>
  <main class="doc flow">
    <PageHeader title="Library" />

    <div class="flex flex-col gap-[1.9em]">
      {
        library.map((yearGroup) => (
          <section>
            <p class="mb-[0.4em] text-foreground-dim">{yearGroup.year}</p>
            <ul class="flex flex-col gap-[0.2em]">
              {yearGroup.books.map((book) => (
                <li class="text-foreground-soft">{book.title}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>
