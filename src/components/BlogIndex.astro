---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "./PageHeader.astro";
import { formatDate } from "../utils/date";
import type { BlogPost } from "../data/blog";

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<BaseLayout
  title="Writing - Garrett Ladley"
  description="Writing by Garrett Ladley."
>
  <main class="doc flow">
    <PageHeader title="Writing" />

    <ul class="flex flex-col gap-[1.1em]">
      {
        posts.map((post) => (
          <li>
            <a class="link" href={`/blog/${post.id}/`}>
              {post.data.title}
            </a>
            <p class="text-meta text-foreground-dim">
              {formatDate(post.data.pubDate)}
            </p>
          </li>
        ))
      }
    </ul>

    <p><a class="link-quiet" href="/rss.xml">RSS</a></p>
  </main>
</BaseLayout>

<script is:inline>
  function handleRssClick() {
    window.posthog?.capture("rss_feed_clicked");
  }

  function setupRssLink() {
    const rssLink = document.querySelector('a[href="/rss.xml"]');
    if (!rssLink) return;
    rssLink.removeEventListener("click", handleRssClick);
    rssLink.addEventListener("click", handleRssClick);
  }

  document.addEventListener("astro:page-load", setupRssLink);
</script>
