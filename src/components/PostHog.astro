---
import {
  PUBLIC_POSTHOG_HOST,
  PUBLIC_POSTHOG_PROJECT_TOKEN,
} from "astro:env/client";

const apiHost = PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com";
---

<script
  is:inline
  define:vars={{
    apiKey: PUBLIC_POSTHOG_PROJECT_TOKEN,
    apiHost,
  }}
>
  if (!window.__posthog_initialized) {
    window.__posthog_initialized = true;

    // Alias domains redirect here with UTM params (see vercel.json). Strip them
    // before PostHog patches history, then attach them to the first pageview so
    // the tagged URL is never shared.
    let aliasParams = null;
    const params = new URLSearchParams(location.search);
    if (params.get("utm_medium") === "alias") {
      aliasParams = {
        utm_source: params.get("utm_source"),
        utm_medium: "alias",
      };
      params.delete("utm_source");
      params.delete("utm_medium");
      const search = params.toString();
      history.replaceState(
        history.state,
        "",
        location.pathname + (search ? "?" + search : "") + location.hash,
      );
    }

    /* eslint-disable */
    !(function (t, e) {
      var o, n, p, r;
      e.__SV ||
        ((window.posthog = e),
        (e._i = []),
        (e.init = function (i, s, a) {
          function g(t, e) {
            var o = e.split(".");
            (2 == o.length && ((t = t[o[0]]), (e = o[1])),
              (t[e] = function () {
                t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
              }));
          }
          (((p = t.createElement("script")).type = "text/javascript"),
            (p.crossOrigin = "anonymous"),
            (p.async = !0),
            (p.fetchPriority = "low"),
            (p.src = s.api_host + "/static/array.js"),
            (r = t.getElementsByTagName("script")[0]).parentNode.insertBefore(
              p,
              r,
            ));
          var u = e;
          for (
            void 0 !== a ? (u = e[a] = []) : (a = "posthog"),
              u.people = u.people || [],
              u.toString = function (t) {
                var e = "posthog";
                return (
                  "posthog" !== a && (e += "." + a),
                  t || (e += " (stub)"),
                  e
                );
              },
              u.people.toString = function () {
                return u.toString(1) + ".people (stub)";
              },
              o =
                "capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId".split(
                  " ",
                ),
              n = 0;
            n < o.length;
            n++
          )
            g(u, o[n]);
          e._i.push([i, s, a]);
        }),
        (e.__SV = 1));
    })(document, window.posthog || []);
    /* eslint-enable */
    posthog.init(apiKey || "", {
      api_host: apiHost,
      defaults: "2026-01-30",
      capture_pageview: "history_change",
      autocapture: true,
      disable_surveys: true,
      // Allow session replay to follow the project's recording settings.
      disable_session_recording: false,
      logs: { captureConsoleLogs: false },
      before_send: function (event) {
        if (aliasParams && event && event.event === "$pageview") {
          event.properties = Object.assign(event.properties || {}, aliasParams);
          aliasParams = null;
        }
        return event;
      },
    });
  }
</script>
