{
  "name": "garrettladley-com",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "astro check --minimumFailingSeverity warning",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --fix --cache",
    "a11y": "axe $(find src/pages -name '*.astro' | sed 's|src/pages/index.astro|http://localhost:4321|;s|src/pages/\\(.*\\)\\.astro|http://localhost:4321/\\1|;s|/index$||' | grep -v '\\[') --exit",
    "format": "oxfmt --check . && prettier --check \"src/**/*.{astro,mdx}\"",
    "format:fix": "oxfmt --write . && prettier --write \"src/**/*.{astro,mdx}\"",
    "vercel:bootstrap": "bash ./scripts/vercel-bootstrap.sh",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.0",
    "@tailwindcss/vite": "^4.2.0",
    "astro": "^7.1.1",
    "posthog-js": "^1.390.0",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/cli": "^4.11.1",
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^9.39.3",
    "@types/node": "^25.3.0",
    "browser-driver-manager": "^2.0.1",
    "eslint": "^9.39.3",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.8.1",
    "globals": "^17.3.0",
    "oxfmt": "^0.34.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "overrides": {
      "basic-ftp": ">=5.3.1",
      "brace-expansion@5": ">=5.0.6",
      "esbuild": ">=0.28.1",
      "fast-uri": ">=3.1.2",
      "ip-address": ">=10.1.1",
      "js-yaml": ">=4.2.0",
      "lodash": ">=4.18.1",
      "path-to-regexp": ">=6.3.0",
      "postcss": ">=8.5.10",
      "tar": ">=7.5.16",
      "tmp": ">=0.2.6",
      "vite": ">=8.0.13 <9",
      "ws@8": ">=8.21.0",
      "yaml": ">=2.8.3"
    },
    "onlyBuiltDependencies": [
      "chromedriver",
      "esbuild",
      "sharp"
    ]
  }
}
