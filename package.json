{
  "name": "garrettladley-com",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check --minimumFailingSeverity warning",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --fix --cache",
    "a11y": "node scripts/a11y.mjs",
    "format": "oxfmt --check . && prettier --check \"src/**/*.{astro,mdx}\"",
    "format:fix": "oxfmt --write . && prettier --write \"src/**/*.{astro,mdx}\"",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.3",
    "@tailwindcss/vite": "^4.2.0",
    "astro": "^7.2.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^9.39.3",
    "@types/node": "^25.3.0",
    "eslint": "^9.39.3",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.8.1",
    "globals": "^17.3.0",
    "oxfmt": "^0.34.0",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "overrides": {
      "basic-ftp": ">=5.3.1",
      "@humanfs/node": ">=0.16.8",
      "brace-expansion@1": ">=1.1.16 <2",
      "brace-expansion@5": ">=5.0.9 <6",
      "dompurify": ">=3.4.13",
      "esbuild": ">=0.28.1",
      "fast-uri": ">=4.1.3",
      "fflate": ">=0.4.9",
      "ip-address": ">=10.3.1",
      "js-yaml": ">=4.3.2 <5",
      "lodash": ">=4.18.1",
      "nanoid": ">=3.3.18 <4",
      "path-to-regexp": ">=6.3.0",
      "postcss": ">=8.5.23",
      "postcss-selector-parser": ">=7.1.3",
      "smol-toml": ">=1.7.1",
      "svgo": ">=4.1.0",
      "tar": ">=7.5.16",
      "tmp": ">=0.2.6",
      "valibot": ">=1.4.2",
      "vite": ">=8.0.13 <9",
      "ws@8": ">=8.21.0",
      "yaml": ">=2.8.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
