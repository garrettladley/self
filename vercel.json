{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/(?:(?:.*/)?\\.(?!well-known(?:/|$))|wp-|wordpress|xmlrpc|cgi-bin|phpmyadmin|phpunit|vendor/|laravel/|yii/|_next/|__nextjs|_middleware|RSC/|api/|v\\d+/|rest/|functions/v\\d+|containers/|_watcher/|actuator|server-status|.*\\.(?:php\\d?|phtml|aspx?|jsp|cgi|env|sql|bak|ini)$)",
      "mitigate": {
        "action": "deny"
      }
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "^www\\.garrettladley\\.com$"
        }
      ],
      "headers": {
        "Location": "https://garrettladley.com/$1"
      },
      "status": 308
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "^(?:www\\.)?garrett\\.agency$"
        }
      ],
      "headers": {
        "Location": "https://garrettladley.com/$1?utm_source=garrett.agency&utm_medium=alias"
      },
      "status": 308
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "^(?:www\\.)?garrett\\.zone$"
        }
      ],
      "headers": {
        "Location": "https://garrettladley.com/$1?utm_source=garrett.zone&utm_medium=alias"
      },
      "status": 308
    },
    {
      "src": "^/health$",
      "headers": {
        "Cache-Control": "no-store",
        "Content-Type": "text/plain; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/(.*)$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), geolocation=(), microphone=(), payment=()",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none'; object-src 'none'; base-uri 'none'",
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
      },
      "continue": true
    }
  ]
}
